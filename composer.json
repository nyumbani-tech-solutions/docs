{
	"name": "nyumbani/docs",
	"type": "library",
	"description": "The docs engine of the Nyumbani packages: a page shell, interactive components and live demos, served only in the local environment, with its own styles and scripts so it works in any Laravel app.",
	"homepage": "https://nyumbanitech.co.ke/",
	"keywords": [
		"laravel",
		"nyumbani",
		"docs"
	],
	"license": "proprietary",
	"authors": [
		{
			"name": "Alvin Kaburu",
			"email": "geekaburu@nyumbanitech.co.ke"
		}
	],
	"require": {
		"php": "^8.3",
		"illuminate/support": "^12.0||^13.0",
		"illuminate/view": "^12.0||^13.0",
		"illuminate/http": "^12.0||^13.0",
		"illuminate/routing": "^12.0||^13.0"
	},
	"autoload": {
		"psr-4": {
			"Nyumbani\\Docs\\": "src/"
		}
	},
	"extra": {
		"laravel": {
			"providers": [
				"Nyumbani\\Docs\\DocsServiceProvider"
			]
		}
	},
	"minimum-stability": "stable",
	"prefer-stable": true
}
